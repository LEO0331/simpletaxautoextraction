rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function validOptionalString(value, maxLen) {
      return value == null || (value is string && value.size() <= maxLen);
    }

    function validTaxRecord(data, userId) {
      return data.keys().hasAll([
          'userId',
          'financialYear',
          'propertyId',
          'propertyName',
          'income',
          'expenses',
          'notes',
          'isLocked',
          'parserVersion',
          'lineItems'
        ])
        && data.keys().hasOnly([
          'userId',
          'financialYear',
          'propertyId',
          'propertyName',
          'income',
          'expenses',
          'notes',
          'isLocked',
          'sourceFileName',
          'sourceParser',
          'parserVersion',
          'lineItems',
          'createdAt',
          'updatedAt'
        ])
        && data.userId == userId
        && validString(data.financialYear, 16)
        && validString(data.propertyId, 64)
        && validString(data.propertyName, 120)
        && (data.income is map)
        && (data.expenses is map)
        && (data.notes is string)
        && data.notes.size() <= 2000
        && (data.isLocked is bool)
        && validOptionalString(data.sourceFileName, 255)
        && validOptionalString(data.sourceParser, 120)
        && validString(data.parserVersion, 24)
        && (data.lineItems is list);
    }

    function validInvestmentType(value) {
      return value == "BUY" || value == "SELL";
    }

    function validInvestmentTransaction(data, userId) {
      return data.keys().hasAll([
          'userId',
          'ticker',
          'securityName',
          'transactionType',
          'tradeDate',
          'units',
          'averagePrice',
          'consideration',
          'brokerage',
          'totalCost',
          'sourceParser',
          'parserVersion',
          'notes',
          'isLocked',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'ticker',
          'securityName',
          'transactionType',
          'tradeDate',
          'settlementDate',
          'units',
          'averagePrice',
          'consideration',
          'brokerage',
          'gst',
          'totalCost',
          'confirmationNumber',
          'accountNumber',
          'sourceFileName',
          'sourceParser',
          'parserVersion',
          'notes',
          'isLocked',
          'createdAt',
          'updatedAt'
        ])
        && data.userId == userId
        && validString(data.ticker, 16)
        && validString(data.securityName, 180)
        && validInvestmentType(data.transactionType)
        && (data.tradeDate is timestamp)
        && (data.settlementDate == null || data.settlementDate is timestamp)
        && (data.units is number) && data.units > 0
        && (data.averagePrice is number) && data.averagePrice > 0
        && (data.consideration is number) && data.consideration >= 0
        && (data.brokerage is number) && data.brokerage >= 0
        && (data.gst == null || ((data.gst is number) && data.gst >= 0))
        && (data.totalCost is number) && data.totalCost > 0
        && validOptionalString(data.confirmationNumber, 64)
        && validOptionalString(data.accountNumber, 64)
        && validOptionalString(data.sourceFileName, 255)
        && validString(data.sourceParser, 120)
        && validString(data.parserVersion, 24)
        && (data.notes is string) && data.notes.size() <= 2000
        && (data.isLocked is bool)
        && (data.createdAt is timestamp)
        && (data.updatedAt is timestamp);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['createdAt', 'updatedAt']);
      allow delete: if false;

      match /tax_records/{recordId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validTaxRecord(request.resource.data, userId);
      }

      match /settings/{settingId} {
        allow read: if isOwner(userId) && settingId == "mappings";
        allow create, update: if isOwner(userId)
          && settingId == "mappings"
          && request.resource.data.keys().hasOnly([
            'income',
            'expense',
            'updatedAt'
          ])
          && request.resource.data.income is map
          && request.resource.data.expense is map;
        allow delete: if false;
      }

      match /properties/{propertyId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'name',
            'createdAt',
            'updatedAt'
          ])
          && validString(request.resource.data.name, 120);
      }

      match /investment_transactions/{transactionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validInvestmentTransaction(request.resource.data, userId);
      }
    }
  }
}

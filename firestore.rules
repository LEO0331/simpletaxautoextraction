rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function validOptionalString(value, maxLen) {
      return value == null || (value is string && value.size() <= maxLen);
    }

    function validTaxRecord(data, userId) {
      return data.keys().hasAll([
          'userId',
          'financialYear',
          'propertyId',
          'propertyName',
          'income',
          'expenses',
          'notes',
          'isLocked',
          'parserVersion',
          'lineItems'
        ])
        && data.keys().hasOnly([
          'userId',
          'financialYear',
          'propertyId',
          'propertyName',
          'income',
          'expenses',
          'notes',
          'isLocked',
          'sourceFileName',
          'sourceParser',
          'parserVersion',
          'lineItems',
          'createdAt',
          'updatedAt'
        ])
        && data.userId == userId
        && validString(data.financialYear, 16)
        && validString(data.propertyId, 64)
        && validString(data.propertyName, 120)
        && (data.income is map)
        && (data.expenses is map)
        && (data.notes is string)
        && data.notes.size() <= 2000
        && (data.isLocked is bool)
        && validOptionalString(data.sourceFileName, 255)
        && validOptionalString(data.sourceParser, 120)
        && validString(data.parserVersion, 24)
        && (data.lineItems is list);
    }

    function validInvestmentType(value) {
      return value == "BUY" || value == "SELL";
    }

    function ledgerGeneration(userId) {
      let path = /databases/$(database)/documents/users/$(userId)/investment_metadata/ledger;
      return exists(path) ? get(path).data.generation : 0;
    }

    function ledgerAdvanced(userId) {
      return getAfter(/databases/$(database)/documents/users/$(userId)/investment_metadata/ledger).data.generation == ledgerGeneration(userId) + 1;
    }

    function validAllocation(data, userId, saleId) {
      let sale = get(/databases/$(database)/documents/users/$(userId)/investment_transactions/$(saleId)).data;
      return data.keys().hasOnly(['sellTransactionId', 'selections', 'transactionRevisions', 'method', 'revision', 'userId', 'updatedAt'])
        && data.userId == userId && data.sellTransactionId == saleId
        && data.selections is list && data.selections.size() > 0 && data.selections.size() <= 4
        && data.transactionRevisions is map && data.transactionRevisions.size() > 0
        && data.method == 'specific' && data.revision is int && data.revision > 0
        && data.updatedAt is timestamp
        && sale.transactionType == 'SELL' && !sale.isLocked && !sale.get('isVoided', false)
        && data.transactionRevisions[saleId] == sale.get('revision', 0)
        && validSelection(data, 0, userId, sale)
        && (data.selections.size() < 2 || validSelection(data, 1, userId, sale))
        && (data.selections.size() < 3 || validSelection(data, 2, userId, sale))
        && (data.selections.size() < 4 || validSelection(data, 3, userId, sale));
    }

    function validSelection(data, index, userId, sale) {
      let selection = data.selections[index];
      let buy = get(/databases/$(database)/documents/users/$(userId)/investment_transactions/$(selection.buyTransactionId)).data;
      return selection is map && selection.keys().hasOnly(['buyTransactionId', 'units'])
        && validString(selection.buyTransactionId, 128)
        && validString(selection.units, 100) && selection.units.matches('^[0-9]+(\\.[0-9]{1,12})?$')
        && buy.transactionType == 'BUY' && !buy.get('isVoided', false)
        && buy.ticker == sale.ticker && buy.accountNumber == sale.accountNumber
        && buy.tradeDate < sale.tradeDate
        && data.transactionRevisions[selection.buyTransactionId] == buy.get('revision', 0);
    }

    function validInvestmentTransaction(data, userId) {
      return data.keys().hasAll([
          'userId',
          'ticker',
          'securityName',
          'transactionType',
          'tradeDate',
          'units',
          'averagePrice',
          'consideration',
          'brokerage',
          'totalCost',
          'sourceParser',
          'parserVersion',
          'notes',
          'isLocked',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'userId',
          'ticker',
          'securityName',
          'transactionType',
          'tradeDate',
          'settlementDate',
          'tradeDateIso',
          'settlementDateIso',
          'units',
          'averagePrice',
          'consideration',
          'brokerage',
          'gst',
          'totalCost',
          'confirmationNumber',
          'accountNumber',
          'sourceFileName',
          'sourceParser',
          'parserVersion',
          'notes',
          'isLocked',
          'isReviewed',
          'isVoided',
          'revision',
          'sourceIdentity',
          'sourceHash',
          'unitsExact',
          'considerationExact',
          'brokerageExact',
          'totalCostExact',

          'createdAt',
          'updatedAt'
        ])
        && data.userId == userId
        && data.get('schemaVersion', 1) in [1, 2]
        && validString(data.ticker, 16)
        && validString(data.securityName, 180)
        && validInvestmentType(data.transactionType)
        && (data.tradeDate is timestamp)
        && validOptionalString(data.get('tradeDateIso', null), 10)
        && validOptionalString(data.get('settlementDateIso', null), 10)
        && (data.settlementDate == null || data.settlementDate is timestamp)
        && (data.units is number) && data.units > 0
        && (data.averagePrice is number) && data.averagePrice > 0
        && (data.consideration is number) && data.consideration >= 0
        && (data.brokerage is number) && data.brokerage >= 0
        && (data.gst == null || ((data.gst is number) && data.gst >= 0))
        && (data.totalCost is number) && data.totalCost > 0
        && validOptionalString(data.confirmationNumber, 64)
        && validOptionalString(data.accountNumber, 64)
        && validOptionalString(data.sourceFileName, 255)
        && validString(data.sourceParser, 120)
        && validString(data.parserVersion, 24)
        && (data.notes is string) && data.notes.size() <= 2000
        && (data.isLocked is bool)
        && (data.get('isReviewed', false) is bool)
        && (data.get('isVoided', false) is bool)
        && (data.get('revision', 0) is int) && data.get('revision', 0) >= 0
        && validOptionalString(data.get('sourceIdentity', null), 64)
        && validOptionalString(data.get('sourceHash', null), 64)
        && validOptionalString(data.get('unitsExact', null), 100)
        && validOptionalString(data.get('considerationExact', null), 100)
        && validOptionalString(data.get('brokerageExact', null), 100)
        && validOptionalString(data.get('totalCostExact', null), 100)
        && (!data.get('isReviewed', false) ||
          (data.schemaVersion == 2
            && data.tradeDateIso is string && data.tradeDateIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && data.unitsExact is string && data.unitsExact.matches('^[0-9]+(\\.[0-9]{1,12})?$')
            && data.considerationExact is string && data.considerationExact.matches('^[0-9]+(\\.[0-9]{1,2})?$')
            && data.brokerageExact is string && data.brokerageExact.matches('^[0-9]+(\\.[0-9]{1,2})?$')
            && data.totalCostExact is string && data.totalCostExact.matches('^[0-9]+(\\.[0-9]{1,2})?$')))
        && (data.createdAt is timestamp)
        && (data.updatedAt is timestamp);
    }

    function fundMoney(value) {
      return value is string && value.matches('^[0-9]{1,30}(\\.[0-9]{1,2})?$');
    }
    function validFundAdjustment(a) {
      return a is map && a.keys().hasOnly(['parcelId', 'amount', 'date', 'evidenceReference', 'beforeSaleId', 'units'])
        && validString(a.parcelId, 128) && validString(a.evidenceReference, 1000)
        && a.amount is string && a.amount.matches('^-?[0-9]{1,30}(\\.[0-9]{1,2})?$')
        && a.date is string && a.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validOptionalString(a.get('beforeSaleId', null), 128)
        && (a.get('units', null) == null || (a.units is string && a.units.matches('^[0-9]{1,30}(\\.[0-9]{1,12})?$')));
    }
    function validFundDrp(a) {
      return a is map && a.keys().hasOnly(['buyTransactionId', 'cashEntitlement', 'reinvestedAmount', 'residualCash', 'evidenceReference'])
        && validString(a.buyTransactionId, 128) && validString(a.evidenceReference, 1000)
        && fundMoney(a.cashEntitlement) && fundMoney(a.reinvestedAmount) && fundMoney(a.residualCash);
    }
    function validFundStatement(d, userId) {
      let components = d.components;
      // One anchored regex validates exactly eleven monetary strings. Embedded
      // delimiters, non-string values and malformed cents fail this expression.
      let amounts = components.get('australianIncome', '0') + '|' + components.get('foreignIncome', '0') + '|' + components.get('frankingCredits', '0') + '|' + components.get('foreignTaxOffset', '0') + '|' + components.get('withholding', '0') + '|' + components.get('cashDistributions', '0') + '|' + components.get('discountedCapitalGain', '0') + '|' + components.get('otherCapitalGain', '0') + '|' + components.get('grossCapitalGain', '0') + '|' + components.get('amitShortfall', '0') + '|' + components.get('amitExcess', '0');
      let adjustments = d.adjustments;
      let drpLinks = d.drpLinks;
      return d.keys().hasOnly(['schemaVersion', 'userId', 'ticker', 'accountNumber', 'issuer', 'layoutVersion', 'yearStart', 'sourceReference', 'regime', 'revision', 'isReviewed', 'isVoided', 'components', 'adjustments', 'drpLinks', 'createdAt', 'updatedAt'])
        && d.schemaVersion == 1 && d.userId == userId
        && validString(d.ticker, 16) && validString(d.accountNumber, 64)
        && validString(d.issuer, 180) && validString(d.layoutVersion, 64)
        && validString(d.sourceReference, 1000)
        && d.yearStart is int && d.yearStart >= 1900 && d.yearStart <= 2199
        && d.regime in ['AMIT', 'non-AMIT'] && d.revision is int && d.revision > 0
        && d.isReviewed is bool && d.isVoided is bool
        && d.createdAt is timestamp && d.updatedAt is timestamp
        && components is map && components.keys().hasOnly(['australianIncome', 'foreignIncome', 'frankingCredits', 'foreignTaxOffset', 'withholding', 'cashDistributions', 'discountedCapitalGain', 'otherCapitalGain', 'grossCapitalGain', 'amitShortfall', 'amitExcess'])
        && amounts.matches('^([0-9]{1,30}(\\.[0-9]{1,2})?\\|){10}[0-9]{1,30}(\\.[0-9]{1,2})?$')
        && adjustments is list && adjustments.size() <= 4
        && (adjustments.size() < 1 || validFundAdjustment(adjustments[0]))
        && (adjustments.size() < 2 || validFundAdjustment(adjustments[1]))
        && (adjustments.size() < 3 || validFundAdjustment(adjustments[2]))
        && (adjustments.size() < 4 || validFundAdjustment(adjustments[3]))
        && drpLinks is list && drpLinks.size() <= 4;
    }
    function validFundDrpHistory(d) {
      // Parent and mandatory mirrored revision jointly validate every field.
      // Splitting DRP validation keeps four adjustments + four links below the
      // per-operation expression ceiling without removing numeric checks.
      let links = d.drpLinks;
      return links is list && links.size() <= 4
        && (links.size() < 1 || validFundDrp(links[0]))
        && (links.size() < 2 || validFundDrp(links[1]))
        && (links.size() < 3 || validFundDrp(links[2]))
        && (links.size() < 4 || validFundDrp(links[3]));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['createdAt', 'updatedAt']);
      allow delete: if false;

      match /tax_records/{recordId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validTaxRecord(request.resource.data, userId);
      }

      match /settings/{settingId} {
        allow read: if isOwner(userId) && settingId == "mappings";
        allow create, update: if isOwner(userId)
          && settingId == "mappings"
          && request.resource.data.keys().hasOnly([
            'income',
            'expense',
            'updatedAt'
          ])
          && request.resource.data.income is map
          && request.resource.data.expense is map;
        allow delete: if false;
      }

      match /properties/{propertyId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'name',
            'createdAt',
            'updatedAt'
          ])
          && validString(request.resource.data.name, 120);
      }

      match /investment_transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow delete: if false;
        allow create: if isOwner(userId)
          && validInvestmentTransaction(request.resource.data, userId)
          && request.resource.data.revision == 1
          && ledgerAdvanced(userId)
          && getAfter(/databases/$(database)/documents/users/$(userId)/investment_transactions/$(transactionId)/revisions/1).data == request.resource.data;
        allow update: if isOwner(userId)
          && validInvestmentTransaction(request.resource.data, userId)
          && request.resource.data.revision == resource.data.get('revision', 0) + 1
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('sourceIdentity', null) == resource.data.get('sourceIdentity', request.resource.data.get('sourceIdentity', null))
          && (!resource.data.isLocked || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isLocked', 'notes', 'revision', 'updatedAt']))
          && ledgerAdvanced(userId)
          && (resource.data.get('revision', 0) != 0 ||
            getAfter(/databases/$(database)/documents/users/$(userId)/investment_transactions/$(transactionId)/revisions/0).data == resource.data)
          && getAfter(/databases/$(database)/documents/users/$(userId)/investment_transactions/$(transactionId)/revisions/$(request.resource.data.revision)).data == request.resource.data;
        match /revisions/{revisionId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId)
            && request.resource.data.userId == userId
            && ((revisionId == '0'
              && get(/databases/$(database)/documents/users/$(userId)/investment_transactions/$(transactionId)).data.get('revision', 0) == 0
              && getAfter(/databases/$(database)/documents/users/$(userId)/investment_transactions/$(transactionId)).data.revision == 1
              && request.resource.data == get(/databases/$(database)/documents/users/$(userId)/investment_transactions/$(transactionId)).data)
              || (revisionId == string(request.resource.data.revision)
                && getAfter(/databases/$(database)/documents/users/$(userId)/investment_transactions/$(transactionId)).data == request.resource.data));
          allow update, delete: if false;
        }
      }

      match /investment_sources/{identity} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['userId', 'transactionId'])
          && request.resource.data.userId == userId
          && validString(request.resource.data.transactionId, 128)
          && getAfter(/databases/$(database)/documents/users/$(userId)/investment_transactions/$(request.resource.data.transactionId)).data.userId == userId;
        allow update, delete: if false;
      }
      match /investment_metadata/{metadataId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && metadataId == 'ledger'
          && request.resource.data.keys().hasOnly(['generation'])
          && request.resource.data.generation is int
          && request.resource.data.generation == ledgerGeneration(userId) + 1;
        allow delete: if false;
      }
      match /investment_allocations/{saleId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && resource == null
          && request.resource.data.revision == 1
          && validAllocation(request.resource.data, userId, saleId)
          && ledgerAdvanced(userId)
          && getAfter(/databases/$(database)/documents/users/$(userId)/investment_allocations/$(saleId)/revisions/1).data == request.resource.data;
        allow update: if isOwner(userId) && resource != null
          && request.resource.data.revision == resource.data.revision + 1
          && validAllocation(request.resource.data, userId, saleId)
          && ledgerAdvanced(userId)
          && getAfter(/databases/$(database)/documents/users/$(userId)/investment_allocations/$(saleId)/revisions/$(request.resource.data.revision)).data == request.resource.data;
        allow delete: if false;
        match /revisions/{revisionId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId)
            && request.resource.data.userId == userId && request.resource.data.sellTransactionId == saleId
            && revisionId == string(request.resource.data.revision)
            && getAfter(/databases/$(database)/documents/users/$(userId)/investment_allocations/$(saleId)).data == request.resource.data;
          allow update, delete: if false;
        }
      }
      match /managed_fund_statements/{statementId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && resource == null && validFundStatement(request.resource.data, userId)
          && request.resource.data.revision == 1 && ledgerAdvanced(userId)
          && getAfter(/databases/$(database)/documents/users/$(userId)/managed_fund_statements/$(statementId)/revisions/1).data == request.resource.data;
        allow update: if isOwner(userId) && resource != null && validFundStatement(request.resource.data, userId)
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.ticker == resource.data.ticker
          && request.resource.data.accountNumber == resource.data.accountNumber
          && request.resource.data.yearStart == resource.data.yearStart
          && ledgerAdvanced(userId)
          && getAfter(/databases/$(database)/documents/users/$(userId)/managed_fund_statements/$(statementId)/revisions/$(request.resource.data.revision)).data == request.resource.data;
        allow delete: if false;
        match /revisions/{revisionId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId) && validFundDrpHistory(request.resource.data)
            && revisionId == string(request.resource.data.revision)
            && getAfter(/databases/$(database)/documents/users/$(userId)/managed_fund_statements/$(statementId)).data == request.resource.data;
          allow update, delete: if false;
        }
      }
      match /investment_calculation_snapshots/{snapshotId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['schemaVersion', 'calculationVersion', 'ruleVersion', 'year', 'status',
            'issues', 'totalCapitalGains', 'currentYearLosses', 'priorLossesUsed', 'lossesCarriedForward',
            'netCapitalGain', 'lossApplications', 'snapshot', 'ledgerGeneration', 'inputRevisions',
            'allocationRevisions', 'statementRevisions', 'openingLossEvidence', 'inputHash', 'calculatedAt', 'userId', 'createdAt'])
          && request.resource.data.userId == userId
          && request.resource.data.createdAt is timestamp
          && request.resource.data.get('statementRevisions', {}) is map
          && request.resource.data.inputRevisions is map
          && (request.resource.data.inputRevisions.size() > 0 ||
            (request.resource.data.schemaVersion == 1 && request.resource.data.snapshot is map
              && request.resource.data.snapshot.context.completeHistory == true
              && request.resource.data.snapshot.context.priorLossesReviewed == true
              && validString(request.resource.data.openingLossEvidence, 2000)))
          && request.resource.data.ledgerGeneration is int
          && request.resource.data.ledgerGeneration == ledgerGeneration(userId);
        allow update, delete: if false;
      }
    }
  }
}
